{
  "manifest_version": 3,
  "name": "Chromium Tab Equalizer",
  "version": "1.0.0",
  "description": "Per-tab audio equalizer and volume controls for Chrome and Brave.",
  "homepage_url": "https://github.com/Majkey25/chromium-tab-equalizer",
  "permissions": [
    "activeTab",
    "offscreen",
    "storage",
    "tabCapture",
    "tabs"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tab Equalizer",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
